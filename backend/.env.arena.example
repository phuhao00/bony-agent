# =============================================================================
# Arena Agent 沙箱环境模板 —— 复制为 .env 后按需修改
# 目标: 在无任何真实付费 Key 的精简环境中跑通内容生成全链路（干跑模式）
# =============================================================================

# --- 基础安全（本地自测可关闭鉴权；对外暴露务必开启）---
AUTH_REQUIRED=false
JWT_SECRET_KEY=change-me-in-production

# --- LLM：干跑模式 = ollama provider 指向本地桩（scripts/arena/llm_stub.py）---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:8765/v1
OLLAMA_MODEL=arena-stub

# --- 沙箱内关闭 Cloudflare 隧道 ---
CLOUDFLARE_TUNNEL_ENABLED=false

# =============================================================================
# 接入真实服务时，按需取消注释 / 修改：
#
# --- 真实 LLM（任选其一，LLM_PROVIDER 同步切换）---
# LLM_PROVIDER=alibaba
# ALIBABA_API_KEY=sk-...            # 通义千问（默认推荐）
# ZHIPUAI_API_KEY=...               # 智谱 GLM-4 / CogView / CogVideoX
# OPENROUTER_API_KEY=...            # GPT-4o / Claude / Gemini 等聚合
# GOOGLE_API_KEY=...
# DEEPSEEK_API_KEY=...
# BYTEDANCE_API_KEY=...
#
# --- 真实媒体生成 ---
# JIMENG_ACCESS_KEY=... / JIMENG_SECRET_KEY=...   # 即梦图片/视频
# ARK_API_KEY=...                                  # 豆包 SeaDance 视频
#
# --- 真实 B-roll 素材（不配则自动用 synthetic 本地合成画面，已验证可出片）---
# PEXELS_API_KEY=...
# PIXABAY_API_KEY=...
# =============================================================================
